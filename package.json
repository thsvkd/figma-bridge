  },
  "dependencies": {
    "cursor-talk-to-figma-mcp": "0.3.5",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
