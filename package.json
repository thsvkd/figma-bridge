{
  "name": "figma-bridge",
  "version": "1.0.0",
  "description": "Talk to Figma MCP bridge for designers and developers",
  "private": true,
  "author": "thsvkd",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
